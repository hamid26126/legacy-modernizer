# Legacy Modernization Agent — backend environment variables.
# Copy to backend/.env (or export in the container) and fill in real values.
# NEVER commit a filled-in .env file.

# ── Credentials ─────────────────────────────────────────────────────────────
# Nebius Token Factory API key — used by planner.py/executor.py for the
# OpenAI-compatible Nemotron endpoint AND by contree-sdk for sandbox auth.
NEBIUS_API_KEY=nb-xxxxxxxxxxxxxxxxxxxxxxxx
# Nebius project id — read by contree-sdk (sandbox verification) as the
# "Project" header.
NEBIUS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Tavily API key — used by planner.py to ground the migration plan.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (whitespace/empty entries ignored).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex alternative (or addition) for origins, passed to
# CORSMiddleware allow_origin_regex. Unset = disabled.
# ALLOWED_ORIGIN_REGEX=https://.*\.example\.com

# ── Abuse / cost protection (0 disables the limit) ─────────────────────────
# Global cap on simultaneous migration streams (in-process semaphore).
MAX_CONCURRENT_MIGRATIONS=3
# Per-client-IP sliding window (1 hour) for plan requests.
MAX_PLANS_PER_HOUR_PER_IP=10
# Per-client-IP sliding window (1 hour) for migration runs.
MAX_MIGRATIONS_PER_HOUR_PER_IP=6
# Global daily migration budget, resets at UTC midnight.
DAILY_MIGRATION_CAP=80

# ── Job retention ───────────────────────────────────────────────────────────
# A job's cloned repo, output dir and progress state are deleted once older
# than this many minutes.
JOB_TTL_MINUTES=90

# ── Container ───────────────────────────────────────────────────────────────
# Port uvicorn binds to inside the container (Dockerfile default 8080).
PORT=8080
